# Configuración pública de Supabase usada por el sitio
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identidad y URL del storefront desplegado (UUID del tenant, sin confiar en el navegador)
PUBLIC_SITE_URL=https://boegrowclub.netlify.app
PUBLIC_TENANT_ID=11111111-1111-1111-1111-111111111111
DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111

# Configuración privada: sólo en Netlify o en el archivo .env local
OPENROUTER_API_KEY=
OPENROUTER_PRODUCT_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=openai/gpt-5-nano
OPENAI_API_KEY=
OPENAI_PRODUCT_MODEL=gpt-5.6
MERCADOLIBRE_ACCESS_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_STATEMENT_DESCRIPTOR=BO GROW CLUB
CRON_SECRET=
# Búsqueda oficial de Google Argentina. Ambas variables quedan sólo en el servidor.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
PRODUCT_ANALYSIS_ALLOWED_ORIGIN=
